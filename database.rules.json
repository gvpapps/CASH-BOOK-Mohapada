{
  "rules": {
    ".read": true,
    ".write": true,
    "cashbook_schools": {
      "$schoolKey": {
        ".validate": "newData.hasChildren(['appData', 'updatedAt', 'schoolCode']) && ('cashbook_' + newData.child('schoolCode').val() === $schoolKey) && (!data.exists() || !data.child('updatedAt').exists() || newData.child('updatedAt').val() >= data.child('updatedAt').val())"
      }
    },
    "cashbook_backups": {
      "$backupKey": {
        ".read": true,
        ".write": true
      }
    },
    "schools": {
      ".read": true,
      ".write": true
    },
    "admin_config": {
      ".read": true,
      ".write": true
    }
  }
}